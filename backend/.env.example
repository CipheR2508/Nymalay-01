# Copy to .env and fill in. Never commit the real file.

# sqlite:///./clinic.db   for local work
# postgresql://nymalaya:<password>@db:5432/nymalaya   in Docker
DATABASE_URL=sqlite:///./clinic.db

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-me-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# `production` turns on the startup SECRET_KEY safety check
ENVIRONMENT=development
DEBUG=true

# Seeds one admin on first boot. Remove the password once the account exists.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nymalay.clinic
ADMIN_PASSWORD=

# The public website books nothing, so every /bookings/ and /appointments/ route
# returns 404 unless this is true. Leave it off: the only supported way to run
# the booking API is behind the `legacy-backend` Compose profile, on a private
# network. See frontend/_inactive/README.md.
ENABLE_LEGACY_BOOKING_API=false
