editorconfig-check=false

# Normalise line endings on commit, keep them in the working tree. The repo is
# developed on Windows and will be built in Linux containers, so files must not
# differ between the two by line ending alone.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary
*.sqlite3 binary
